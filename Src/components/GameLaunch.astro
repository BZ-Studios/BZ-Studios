---
import type { Game } from '../types/game';
import { getGameAccess } from '../lib/game-access.mjs';

interface Props {
  game: Game;
  compact?: boolean;
}

const { game, compact = false } = Astro.props;
const { href } = getGameAccess(game);
const label = compact ? 'Jugar' : 'Jugar ahora';
---

{href && (
  <a
    class:list={['button', 'button--primary', { 'button--small': compact }]}
    data-card-play
    href={href}
    target="_blank"
    rel="noreferrer"
  >
    {label} <span aria-hidden="true">↗</span>
  </a>
)}
