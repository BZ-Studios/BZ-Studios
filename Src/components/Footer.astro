---
import { siteConfig, type SocialKey } from '../config/site';
import LegalDocument from './LegalDocument.astro';
import { privacyDocument, termsDocument } from '../config/legal';

const socialLabels: Record<SocialKey, string> = {
  instagram: 'Instagram',
  x: 'X',
  tiktok: 'TikTok',
  youtube: 'YouTube',
  discord: 'Discord',
  email: 'Email',
};
const footerSocialEntries = siteConfig.footerSocials.map((key) => ({
  key,
  label: socialLabels[key],
  url: siteConfig.socialLinks[key],
}));
---

<footer class="site-footer">
  <div class="shell footer-grid">
    <div class="footer-brand">
      <img class="footer-logo" src="/brand/logo-transparent.png" alt="B&Z Studios" width="1672" height="941" loading="lazy" />
      <p>Videojuegos independientes hechos con ideas compartidas, curiosidad y oficio.</p>
    </div>
    <div>
      <p class="footer-title">Explorar</p>
      <nav class="footer-links" aria-label="Navegación del pie">
        {siteConfig.navigation.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
    </div>
    <div>
      <p class="footer-title">Contacto</p>
      <div class="footer-links">
        {footerSocialEntries.map(({ label, url }) => url
          ? <a href={url} target="_blank" rel="noreferrer">{label}</a>
          : <span class="footer-link--pending">{label} <small>Próximamente</small></span>
        )}
      </div>
    </div>
  </div>
  <div class="shell footer-bottom">
    <span>© {new Date().getFullYear()} B&Z Studios</span>
    <nav class="footer-legal" aria-label="Información legal"><button type="button" data-modal-open="footer-terms-dialog">Términos y condiciones</button><button type="button" data-modal-open="footer-privacy-dialog">Política de privacidad</button></nav>
  </div>
  <dialog class="account-legal-dialog" id="footer-terms-dialog" data-modal-dialog aria-labelledby="footer-terms-title">
    <div class="account-legal-dialog__heading"><div><p class="kicker">{termsDocument.eyebrow}</p><h2 id="footer-terms-title">{termsDocument.title}</h2></div><button type="button" data-modal-close aria-label="Cerrar términos">×</button></div>
    <div class="account-legal-dialog__body"><LegalDocument document={termsDocument} compact /></div>
    <button class="button button--primary" type="button" data-modal-close>Entendido</button>
  </dialog>
  <dialog class="account-legal-dialog" id="footer-privacy-dialog" data-modal-dialog aria-labelledby="footer-privacy-title">
    <div class="account-legal-dialog__heading"><div><p class="kicker">{privacyDocument.eyebrow}</p><h2 id="footer-privacy-title">{privacyDocument.title}</h2></div><button type="button" data-modal-close aria-label="Cerrar política de privacidad">×</button></div>
    <div class="account-legal-dialog__body"><LegalDocument document={privacyDocument} compact /></div>
    <button class="button button--primary" type="button" data-modal-close>Entendido</button>
  </dialog>
</footer>
