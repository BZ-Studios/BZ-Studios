---
import { getYouTubeEmbedUrl, getYouTubeThumbnailUrl, getYouTubeVideoId } from '../lib/youtube.mjs';

interface Props {
  gameName: string;
  screenshots?: string[];
  cover?: string;
  videoUrls?: string[];
}

const { gameName, screenshots = [], cover, videoUrls = [] } = Astro.props;
const youtubeIds = videoUrls
  .map(getYouTubeVideoId)
  .filter((id): id is string => Boolean(id))
  .filter((id, index, ids) => ids.indexOf(id) === index);
const images = [cover, ...screenshots]
  .filter((src): src is string => Boolean(src))
  .filter((src, index, sources) => sources.indexOf(src) === index);
const media = [
  ...images.map((src, index) => ({ type: 'image' as const, src, index, isCover: src === cover })),
  ...youtubeIds.map((youtubeId) => ({ type: 'video' as const, src: getYouTubeThumbnailUrl(youtubeId), youtubeId })),
];
---

{media.length > 0 && (
  <div class="game-media-carousel game-media-carousel--hero" data-game-media-carousel tabindex="0" aria-label={`Videos e imágenes de ${gameName}`}>
        <div class="game-media-viewer" data-media-viewer>
        <div class="game-media-stage">
          {media.map((item, mediaIndex) => (
            <figure class:list={['game-media-slide', { 'is-active': mediaIndex === 0 }]} data-media-slide data-media-type={item.type} data-media-index={mediaIndex} hidden={mediaIndex !== 0}>
              {item.type === 'video' ? (
                <div class="game-media-video">
                  <button type="button" class="game-media-video__poster" data-video-play data-youtube-id={item.youtubeId} data-embed-url={getYouTubeEmbedUrl(item.youtubeId)} aria-label={`Reproducir video de ${gameName}`}>
                    <img src={item.src} alt="" loading="lazy" width="960" height="540" />
                    <span class="game-media-play" aria-hidden="true"><i></i></span>
                  </button>
                  <div class="game-media-video__player" data-video-player hidden></div>
                </div>
              ) : (
                <img src={item.src} alt={item.isCover ? `Portada de ${gameName}` : `Captura ${cover ? item.index : item.index + 1} de ${gameName}`} loading={mediaIndex === 0 ? 'eager' : 'lazy'} width="1280" height="720" />
              )}
            </figure>
          ))}

          {media.length > 1 && <>
            <button class="game-media-nav is-previous" type="button" data-media-previous aria-label="Elemento anterior"><span aria-hidden="true">←</span></button>
            <button class="game-media-nav is-next" type="button" data-media-next aria-label="Elemento siguiente"><span aria-hidden="true">→</span></button>
          </>}
        </div>
        <div class="game-media-tools">
          <span class="game-media-counter" data-media-counter aria-live="polite">1 / {media.length}</span>
          <button class="game-media-fullscreen" type="button" data-media-fullscreen hidden aria-label="Ver video en pantalla completa"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 3H3v5m13-5h5v5M3 16v5h5m13-5v5h-5" /></svg><span data-fullscreen-label>Pantalla completa</span></button>
        </div>
        </div>

        {media.length > 1 && <div class="game-media-thumbnails" role="tablist" aria-label="Seleccionar elemento de la galería">
          {media.map((item, mediaIndex) => (
            <button type="button" role="tab" class:list={['game-media-thumbnail', { 'is-active': mediaIndex === 0 }]} aria-label={item.type === 'video' ? `Ver video de ${gameName}` : item.isCover ? `Ver portada de ${gameName}` : `Ver imagen ${cover ? item.index : item.index + 1} de ${gameName}`} aria-selected={mediaIndex === 0 ? 'true' : 'false'} data-media-thumbnail data-media-index={mediaIndex}>
              <img src={item.src} alt="" loading="lazy" width="240" height="135" />
              {item.type === 'video' && <i aria-hidden="true">▶</i>}
            </button>
          ))}
        </div>}
  </div>
)}

<script>
  document.querySelectorAll<HTMLElement>('[data-game-media-carousel]').forEach((carousel) => {
    const slides = Array.from(carousel.querySelectorAll<HTMLElement>('[data-media-slide]'));
    const thumbnails = Array.from(carousel.querySelectorAll<HTMLButtonElement>('[data-media-thumbnail]'));
    const counter = carousel.querySelector<HTMLElement>('[data-media-counter]');
    const previous = carousel.querySelector<HTMLButtonElement>('[data-media-previous]');
    const next = carousel.querySelector<HTMLButtonElement>('[data-media-next]');
    const viewer = carousel.querySelector<HTMLElement>('[data-media-viewer]');
    const fullscreen = carousel.querySelector<HTMLButtonElement>('[data-media-fullscreen]');
    let activeIndex = 0;
    let pointerStart = 0;
    const isExpanded = () => document.fullscreenElement === viewer || Boolean(viewer?.classList.contains('is-expanded'));
    const syncFullscreen = () => {
      const expanded = isExpanded();
      fullscreen?.setAttribute('aria-label', expanded ? 'Salir de pantalla completa' : 'Ver video en pantalla completa');
      const label = fullscreen?.querySelector<HTMLElement>('[data-fullscreen-label]');
      if (label) label.textContent = expanded ? 'Salir de pantalla completa' : 'Pantalla completa';
      if (fullscreen) fullscreen.hidden = !expanded && slides[activeIndex]?.dataset.mediaType !== 'video';
    };
    const closeExpandedView = () => {
      viewer?.classList.remove('is-expanded');
      document.documentElement.removeAttribute('data-media-expanded');
      syncFullscreen();
    };

    const stopVideo = (slide: HTMLElement) => {
      const poster = slide.querySelector<HTMLButtonElement>('[data-video-play]');
      const player = slide.querySelector<HTMLElement>('[data-video-player]');
      if (!player) return;
      player.replaceChildren();
      player.hidden = true;
      if (poster) poster.hidden = false;
    };

    const playVideo = (slide: HTMLElement) => {
      const poster = slide.querySelector<HTMLButtonElement>('[data-video-play]');
      const player = slide.querySelector<HTMLElement>('[data-video-player]');
      const embedUrl = poster?.dataset.embedUrl;
      if (!poster || !player || !embedUrl) return;
      const iframe = document.createElement('iframe');
      iframe.src = `${embedUrl}&autoplay=1`;
      iframe.title = poster.getAttribute('aria-label') ?? 'Tráiler del juego';
      iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      iframe.allowFullscreen = true;
      iframe.referrerPolicy = 'strict-origin-when-cross-origin';
      player.replaceChildren(iframe);
      poster.hidden = true;
      player.hidden = false;
    };

    const select = (requestedIndex: number, play = false) => {
      if (!slides.length) return;
      const index = (requestedIndex + slides.length) % slides.length;
      slides.forEach((slide, slideIndex) => {
        const active = slideIndex === index;
        slide.hidden = !active;
        slide.classList.toggle('is-active', active);
        if (!active) stopVideo(slide);
      });
      thumbnails.forEach((thumbnail, thumbnailIndex) => {
        const active = thumbnailIndex === index;
        thumbnail.classList.toggle('is-active', active);
        thumbnail.setAttribute('aria-selected', String(active));
        if (active) thumbnail.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
      });
      activeIndex = index;
      syncFullscreen();
      if (counter) counter.textContent = `${index + 1} / ${slides.length}`;
      if (play && slides[index]?.dataset.mediaType === 'video') playVideo(slides[index]);
    };

    previous?.addEventListener('click', () => select(activeIndex - 1));
    next?.addEventListener('click', () => select(activeIndex + 1));
    fullscreen?.addEventListener('click', async () => {
      if (!viewer) return;
      if (viewer.classList.contains('is-expanded')) { closeExpandedView(); return; }
      try {
        if (document.fullscreenElement === viewer) await document.exitFullscreen();
        else {
          const request = viewer.requestFullscreen();
          const slide = slides[activeIndex];
          if (slide?.dataset.mediaType === 'video' && !slide.querySelector('iframe')) playVideo(slide);
          await request;
        }
      } catch {
        // Some mobile browsers or embedded contexts deny native fullscreen.
        // Still expand the player to fill the browser, with an accessible exit.
        viewer.classList.add('is-expanded');
        const slide = slides[activeIndex];
        if (slide?.dataset.mediaType === 'video' && !slide.querySelector('iframe')) playVideo(slide);
        document.documentElement.setAttribute('data-media-expanded', '');
        syncFullscreen();
      }
    });
    document.addEventListener('fullscreenchange', syncFullscreen);
    document.addEventListener('keydown', event => {
      if (event.key === 'Escape' && viewer?.classList.contains('is-expanded')) {
        closeExpandedView();
        fullscreen?.focus();
      }
    });
    thumbnails.forEach((thumbnail) => thumbnail.addEventListener('click', () => select(Number(thumbnail.dataset.mediaIndex ?? 0))));
    slides.forEach((slide) => slide.querySelector<HTMLButtonElement>('[data-video-play]')?.addEventListener('click', () => playVideo(slide)));
    carousel.addEventListener('keydown', (event) => {
      if (event.target instanceof Element && event.target.closest('button, a, iframe')) return;
      if (event.key === 'ArrowLeft') { event.preventDefault(); select(activeIndex - 1); }
      if (event.key === 'ArrowRight') { event.preventDefault(); select(activeIndex + 1); }
    });
    carousel.addEventListener('pointerdown', (event) => { pointerStart = event.clientX; });
    carousel.addEventListener('pointerup', (event) => {
      const distance = event.clientX - pointerStart;
      if (Math.abs(distance) < 55) return;
      select(activeIndex + (distance < 0 ? 1 : -1));
    });
    syncFullscreen();
  });
</script>
