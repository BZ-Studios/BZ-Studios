---
import { ADMIN_ROLE_LABELS, type AdminRole } from '../../config/bzId';

interface Props {
  email?: string;
  role: AdminRole;
}
const { email, role } = Astro.props;
---

<header class="admin-topbar">
  <div class="admin-shell admin-topbar__inner">
    <a class="admin-brand" href="/admin/"><img src="/brand/logo-transparent.png" alt="B&Z Studios" width="1672" height="941" /><span>Administración</span></a>
    <nav class="admin-nav" aria-label="Secciones del panel">
      <a href="/admin/#juegos">Juegos</a><a href="/admin/#equipo">Equipo</a><a href="/admin/#usuarios">B&Z ID</a><a href="/admin/#mensajes">Mensajes</a>
    </nav>
    <div class="admin-user">
      <span>{email}<small>{ADMIN_ROLE_LABELS[role]}</small></span>
      <a class="button button--ghost button--small" href="/" target="_blank" rel="noreferrer">Ver sitio ↗</a>
      <button class="button button--ghost button--small" type="button" data-logout-open>Salir</button>
    </div>
  </div>
</header>

<dialog class="admin-dialog" data-logout-dialog aria-labelledby="logout-title">
  <div class="admin-dialog__icon" aria-hidden="true">↪</div>
  <p class="kicker">Panel privado</p>
  <h2 id="logout-title">¿Cerrar sesión?</h2>
  <p>Vas a salir del panel de administración. Podrás volver a ingresar con tu cuenta autorizada.</p>
  <div class="admin-dialog__actions">
    <button class="button button--ghost" type="button" data-logout-cancel>Cancelar</button>
    <form method="post" action="/admin/logout/"><button class="button button--danger" type="submit">Sí, salir</button></form>
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-logout-dialog]');
  document.querySelector('[data-logout-open]')?.addEventListener('click', () => dialog?.showModal());
  document.querySelector('[data-logout-cancel]')?.addEventListener('click', () => dialog?.close());
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });
</script>
