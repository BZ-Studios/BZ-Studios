---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { siteConfig } from '../config/site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = siteConfig.name,
  description = siteConfig.description,
  image = '/brand/og-brand.webp',
  imageAlt = 'B&Z Studios, estudio independiente de videojuegos',
  noindex = false,
  schema,
} = Astro.props;

const pageTitle = title === siteConfig.name ? title : `${title} | ${siteConfig.name}`;
const siteUrl = new URL('/', Astro.site ?? siteConfig.url);
const canonical = new URL(Astro.url.pathname, siteUrl);
const imageUrl = new URL(image, siteUrl);
const sameAs = Object.values(siteConfig.socialLinks).filter(Boolean);
const organizationSchema = {
  '@type': 'Organization',
  '@id': `${siteUrl.href}#organization`,
  name: siteConfig.name,
  alternateName: siteConfig.shortName,
  url: siteUrl.href,
  description: siteConfig.description,
  logo: new URL('/brand/logo-transparent.png', siteUrl).href,
  founder: siteConfig.members.map((name) => ({ '@type': 'Person', name })),
  ...(sameAs.length > 0 ? { sameAs } : {}),
};
const websiteSchema = {
  '@type': 'WebSite',
  '@id': `${siteUrl.href}#website`,
  url: siteUrl.href,
  name: siteConfig.name,
  alternateName: siteConfig.shortName,
  description: siteConfig.description,
  inLanguage: siteConfig.locale,
  publisher: { '@id': `${siteUrl.href}#organization` },
};
const webPageSchema = {
  '@type': 'WebPage',
  '@id': `${canonical.href}#webpage`,
  url: canonical.href,
  name: pageTitle,
  description,
  inLanguage: siteConfig.locale,
  isPartOf: { '@id': `${siteUrl.href}#website` },
  about: { '@id': `${siteUrl.href}#organization` },
};
const baseSchema = {
  '@context': 'https://schema.org',
  '@graph': [organizationSchema, websiteSchema, webPageSchema],
};
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#0b0710" />
    <meta name="description" content={description} />
    <meta name="author" content={siteConfig.name} />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1'} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <title>{pageTitle}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(baseSchema)} />
    {schema && <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body>
    <Header />
    <div class="scroll-progress" aria-hidden="true"><span data-scroll-progress></span></div>
    <main id="contenido"><slot /></main>
    <Footer />
<script>
  // One observer, no scroll listeners; content stays visible without JavaScript.
  const motionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (!motionPreference.matches && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('motion-reveal');
        observer.unobserve(entry.target);
      });
    }, { threshold: 0.12 });
    document.querySelectorAll('.section-heading, .game-card, .member-card, .studio-strip__grid, .manifesto__grid, .contact-aside, .contact-form, .help-cta, .next-level__inner').forEach((element) => observer.observe(element));
    motionPreference.addEventListener('change', () => {
      if (motionPreference.matches) observer.disconnect();
    });
  }
  const progress = document.querySelector<HTMLElement>('[data-scroll-progress]');
  let progressFrame = 0;
  const updateScrollProgress = () => {
    progressFrame = 0;
    const maximum = document.documentElement.scrollHeight - window.innerHeight;
    const ratio = maximum > 0 ? Math.min(1, Math.max(0, window.scrollY / maximum)) : 0;
    progress?.style.setProperty('--scroll-progress', String(ratio));
  };
  const scheduleProgressUpdate = () => {
    if (!progressFrame) progressFrame = requestAnimationFrame(updateScrollProgress);
  };
  window.addEventListener('scroll', scheduleProgressUpdate, { passive: true });
  window.addEventListener('resize', scheduleProgressUpdate);
  window.addEventListener('pageshow', updateScrollProgress);
  updateScrollProgress();
</script>
  </body>
</html>
