---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GameCard from '../../components/GameCard.astro';
import GameRating from '../../components/GameRating.astro';
import { siteConfig } from '../../config/site';
import { getPublicGameBySlug, getPublicGames } from '../../lib/games';
import { getAccount } from '../../lib/account';

const game = await getPublicGameBySlug(Astro.params.slug ?? '');
if (!game) return Astro.redirect('/404/', 302);

const games = await getPublicGames();
const related = games.filter((item) => item.slug !== game.slug && item.genres.some((genre) => game.genres.includes(genre))).slice(0, 3);
const { supabase, user } = await getAccount(Astro.request, Astro.cookies);
const { data: ownRating } = user && supabase ? await supabase.from('game_ratings').select('score').eq('game_id', game.id).eq('user_id', user.id).maybeSingle() : { data: null };
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? siteConfig.url).href;
const primaryGenre = game.genres[0]?.toLocaleLowerCase('es-AR');
const genrePhrase = primaryGenre ? ` de ${primaryGenre}` : '';
const canPlayOnline = Boolean(game.playUrl && game.status !== 'Próximamente');
const defaultSeoTitle = `${game.name}: videojuego${genrePhrase}${canPlayOnline ? ' online' : ''}`;
const supportingSeoText = game.shortDescription.trim().length >= 50
  ? game.shortDescription.trim()
  : canPlayOnline
    ? 'Jugalo online directamente desde tu navegador.'
    : 'Conocé su desarrollo, novedades y próximos lanzamientos.';
const defaultSeoDescription = `${game.name} es un videojuego${genrePhrase} de B&Z Studios. ${supportingSeoText}`;
const pageSeoTitle = game.seoTitle.trim().length >= game.name.length + 12 ? game.seoTitle : defaultSeoTitle;
const pageSeoDescription = game.seoDescription.trim().length >= 110 ? game.seoDescription : defaultSeoDescription;
const gameSchema = {
  '@context': 'https://schema.org',
  '@type': 'VideoGame',
  name: game.name,
  description: pageSeoDescription,
  ...(game.cover ? { image: new URL(game.cover, Astro.site ?? Astro.url.origin).href } : {}),
  genre: game.genres,
  url: canonicalUrl,
  inLanguage: siteConfig.locale,
  applicationCategory: 'Game',
  gamePlatform: game.platforms?.length ? game.platforms : ['Web browser'],
  publisher: { '@type': 'Organization', name: siteConfig.name, url: siteConfig.url },
  creator: siteConfig.members.map((name) => ({ '@type': 'Person', name })),
  ...(game.ratingCount && game.ratingAverage ? { aggregateRating: { '@type': 'AggregateRating', ratingValue: game.ratingAverage, ratingCount: game.ratingCount, bestRating: 5, worstRating: 1 } } : {}),
  ...(game.playUrl ? { potentialAction: { '@type': 'PlayAction', target: game.playUrl } } : {}),
};
---

<BaseLayout
  title={pageSeoTitle}
  description={pageSeoDescription}
  image={game.cover}
  imageAlt={game.cover ? `Portada de ${game.name}` : 'B&Z Studios, estudio independiente de videojuegos'}
  schema={gameSchema}
>
  <article>
    <header class="game-detail-hero">
      <div class="shell game-detail-hero__grid">
        {game.cover ? (
          <img src={game.cover} alt={`Portada de ${game.name}`} width="900" height="600" />
        ) : (
          <div class="game-detail-placeholder" aria-label={`${game.name}, portada próximamente`}>
            <span>Primer lanzamiento</span>
            <strong>{game.name}</strong>
          </div>
        )}
        <div>
          <span class="status-badge" data-status={game.status}><span aria-hidden="true"></span>{game.status}</span>
          <p class="kicker">{game.genres.join(' · ')}</p>
          <h1>{game.name}</h1>
          <p class="lead">{game.description}</p>
          <div class="button-row">
            {game.playUrl && game.status !== 'Próximamente' && <a class="button button--primary" href={game.playUrl} target="_blank" rel="noreferrer">Jugar ahora <span aria-hidden="true">↗</span></a>}
            {game.trailerUrl && <a class="button button--ghost" href={game.trailerUrl} target="_blank" rel="noreferrer">Ver tráiler <span aria-hidden="true">↗</span></a>}
          </div>
        </div>
      </div>
    </header>
    <section class="section rating-section"><div class="shell"><GameRating gameId={game.id} average={game.ratingAverage} count={game.ratingCount} userScore={ownRating?.score} authenticated={Boolean(user)} verified={Boolean(user?.email_confirmed_at)} returnTo={`/juegos/${game.slug}/`} /></div></section>
    {game.features && game.features.length > 0 && (
      <section class="section"><div class="shell narrow"><p class="kicker">Características</p><h2>Lo que te espera</h2><ul class="feature-list">{game.features.map((feature) => <li>{feature}</li>)}</ul></div></section>
    )}
    {game.screenshots && game.screenshots.length > 0 && (
      <section class="section"><div class="shell"><p class="kicker">Galería</p><h2>Dentro del juego</h2><div class="screenshot-grid">{game.screenshots.map((shot, index) => <img src={shot} alt={`Captura ${index + 1} de ${game.name}`} loading="lazy" width="900" height="506" />)}</div></div></section>
    )}
    {game.controls && game.controls.length > 0 && (
      <section class="section"><div class="shell narrow"><p class="kicker">Controles</p><h2>Listo para jugar</h2><dl class="control-list">{game.controls.map((control) => <><dt>{control.input}</dt><dd>{control.action}</dd></>)}</dl></div></section>
    )}
    {related.length > 0 && <section class="section"><div class="shell"><p class="kicker">Seguí jugando</p><h2>Otros mundos</h2><div class="game-grid">{related.map((item) => <GameCard game={item} />)}</div></div></section>}
  </article>
</BaseLayout>
