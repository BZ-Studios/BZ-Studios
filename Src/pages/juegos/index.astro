---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GameCard from '../../components/GameCard.astro';
import EmptyCatalog from '../../components/EmptyCatalog.astro';
import { getPublicGames } from '../../lib/games';

const games = await getPublicGames();
const gameGenres = [...new Set(games.flatMap((game) => game.genres))].sort((a, b) => a.localeCompare(b, 'es'));
---

<BaseLayout title="Juegos" description="Explorá la cartelera de videojuegos de B&Z Studios.">
  <section class="page-hero page-hero--catalog">
    <div class="shell">
      <p class="kicker">Cartelera</p>
      <h1>Elegí tu próxima partida</h1>
      <p>Descubrí nuestros proyectos, conocé cómo se juegan y entrá directo a cada mundo.</p>
    </div>
  </section>
  <section class="section catalog-section">
    <div class="shell">
      {games.length > 0 ? (
        <>
          <div class="genre-filter" aria-label="Filtrar juegos por género">
            <button class="filter-button is-active" type="button" data-filter="all" aria-pressed="true">Todos</button>
            {gameGenres.map((genre) => <button class="filter-button" type="button" data-filter={genre} aria-pressed="false">{genre}</button>)}
          </div>
          <p class="filter-status" aria-live="polite">{games.length} {games.length === 1 ? 'juego' : 'juegos'}</p>
          <div class="game-grid" data-game-grid>{games.map((game) => <GameCard game={game} />)}</div>
        </>
      ) : <EmptyCatalog />}
    </div>
  </section>
</BaseLayout>

{games.length > 0 && (
  <script>
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const cards = document.querySelectorAll<HTMLElement>('[data-genre]');
    const status = document.querySelector<HTMLElement>('.filter-status');
    buttons.forEach((button) => button.addEventListener('click', () => {
      const filter = button.dataset.filter ?? 'all';
      buttons.forEach((item) => {
        const active = item === button;
        item.classList.toggle('is-active', active);
        item.setAttribute('aria-pressed', String(active));
      });
      let visible = 0;
      cards.forEach((card) => {
        const match = filter === 'all' || (card.dataset.genre ?? '').split('|').includes(filter);
        card.hidden = !match;
        if (match) visible += 1;
      });
      if (status) status.textContent = `${visible} ${visible === 1 ? 'juego' : 'juegos'}`;
    }));
  </script>
)}
