---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GameCard from '../../components/GameCard.astro';
import EmptyCatalog from '../../components/EmptyCatalog.astro';
import { GAME_GENRES } from '../../config/gameGenres';
import { getPublicGames } from '../../lib/games';

const games = await getPublicGames();
---

<BaseLayout title="Juegos indie para jugar online" description="Explorá los videojuegos independientes de B&Z Studios, conocé sus controles y jugá online directamente desde tu navegador.">
  <section class="page-hero page-hero--catalog">
    <div class="shell">
      <p class="kicker">Cartelera</p>
      <h1>Elegí tu próxima partida</h1>
      <p>Descubrí nuestros videojuegos independientes, conocé cómo se juegan y entrá directo a cada mundo.</p>
    </div>
  </section>
  <section class="section catalog-section">
    <div class="shell">
      {games.length > 0 ? (
        <>
          <div class="genre-filter">
            <label for="genre-filter">Género</label>
            <div class="genre-filter__control">
              <select id="genre-filter" data-genre-filter aria-label="Filtrar juegos por género">
                <option value="all">Todos</option>
                {GAME_GENRES.map((genre) => <option value={genre}>{genre}</option>)}
              </select>
            </div>
          </div>
          <p class="filter-status" aria-live="polite">{games.length} {games.length === 1 ? 'juego' : 'juegos'}</p>
          <div class="game-grid" data-game-grid>{games.map((game) => <GameCard game={game} />)}</div>
        </>
      ) : <EmptyCatalog />}
    </div>
  </section>
</BaseLayout>

{games.length > 0 && (
  <script>
    const select = document.querySelector<HTMLSelectElement>('[data-genre-filter]');
    const cards = document.querySelectorAll<HTMLElement>('[data-genre]');
    const status = document.querySelector<HTMLElement>('.filter-status');
    select?.addEventListener('change', () => {
      const filter = select.value;
      let visible = 0;
      cards.forEach((card) => {
        const match = filter === 'all' || (card.dataset.genre ?? '').split('|').includes(filter);
        card.hidden = !match;
        if (match) visible += 1;
      });
      if (status) status.textContent = `${visible} ${visible === 1 ? 'juego' : 'juegos'}`;
    });
  </script>
)}
