---
export const prerender = false;

import AccountLayout from '../../layouts/AccountLayout.astro';
import PasswordEye from '../../components/PasswordEye.astro';
import { getAccount, sameOrigin, validPassword } from '../../lib/account';
import { describeAuthFailure } from '../../lib/auth-errors';

const { supabase } = await getAccount(Astro.request, Astro.cookies);
const email = Astro.cookies.get('pending_recovery_email')?.value ?? '';
let error = '';
let changed = false;
let restartRequired = false;

if (!email && Astro.request.method !== 'POST') return Astro.redirect('/cuenta/recuperar/');

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const token = String(form.get('token') ?? '').replace(/\s/g, '');
  const password = String(form.get('password') ?? '');
  const confirmation = String(form.get('confirmation') ?? '');

  if (!sameOrigin(Astro.request)) error = 'Solicitud no válida.';
  else if (!supabase || !email) error = 'La solicitud venció. Pedí un código nuevo.';
  else if (!/^\d{6}$/.test(token)) error = 'El código debe tener exactamente 6 números.';
  else if (!validPassword(password)) error = 'Usá 8 caracteres como mínimo, mayúscula, minúscula, número y símbolo.';
  else if (password !== confirmation) error = 'Las contraseñas no coinciden.';
  else {
    const verification = await supabase.auth.verifyOtp({ email, token, type: 'recovery' });
    if (verification.error || !verification.data.user) {
      error = describeAuthFailure(verification.error, 'El código no es válido o ya venció. Solicitá uno nuevo.');
    } else {
      const update = await supabase.auth.updateUser({ password });
      if (update.error) {
        error = describeAuthFailure(update.error, 'No pudimos actualizar la contraseña. Solicitá un código nuevo e intentá nuevamente.');
        Astro.cookies.delete('pending_recovery_email', { path: '/cuenta/' });
        await supabase.auth.signOut();
        restartRequired = true;
      }
      else {
        Astro.cookies.delete('pending_recovery_email', { path: '/cuenta/' });
        await supabase.auth.signOut();
        changed = true;
      }
    }
  }
}
---

<AccountLayout title="Nueva contraseña" description="Confirmá el código recibido y elegí una contraseña nueva.">
  {changed ? <div class="account-notice"><strong>Contraseña actualizada</strong><p>La contraseña se cambió correctamente. Ya podés iniciar sesión con la nueva.</p><a class="button button--primary" href="/cuenta/login/">Iniciar sesión</a></div> : <>
    <div class="verification-intro"><p class="kicker">Código de 6 dígitos</p><p>Ingresá el código que enviamos a <strong>{email}</strong> y creá tu contraseña nueva.</p></div>
    {restartRequired ? <div class="account-form"><p class="form-status is-error" role="alert">{error}</p><a class="button button--primary" href="/cuenta/recuperar/">Solicitar un código nuevo</a></div> :
    <form class="account-form" method="post" data-password-form novalidate>
      {error && <p class="form-status is-error" role="alert">{error}</p>}
      <label>Código de recuperación<input class="verification-code" name="token" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" minlength="6" maxlength="6" placeholder="000000" required /></label>
      <div class="account-field"><label for="reset-password">Nueva contraseña</label><div class="account-password-control"><input id="reset-password" name="password" type="password" autocomplete="new-password" minlength="8" data-password required /><button type="button" data-password-toggle aria-controls="reset-password" aria-label="Mostrar contraseña" aria-pressed="false"><PasswordEye /></button></div><small>8 caracteres como mínimo, con mayúscula, minúscula, número y símbolo.</small><span class="field-feedback" data-password-feedback aria-live="polite"></span></div>
      <div class="account-field"><label for="reset-confirmation">Confirmar contraseña nueva</label><div class="account-password-control"><input id="reset-confirmation" name="confirmation" type="password" autocomplete="new-password" minlength="8" data-password-confirmation required /><button type="button" data-password-toggle aria-controls="reset-confirmation" aria-label="Mostrar contraseña" aria-pressed="false"><PasswordEye /></button></div><span class="field-feedback" data-confirmation-feedback aria-live="polite"></span></div>
      <button class="button button--primary" type="submit">Confirmar nueva contraseña</button>
      <a class="text-link" href="/cuenta/recuperar/">Solicitar otro código</a>
    </form>}
  </>}
</AccountLayout>
