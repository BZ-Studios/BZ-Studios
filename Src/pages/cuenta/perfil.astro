---
import AccountLayout from '../../layouts/AccountLayout.astro';
import { createAdminAuthClient, getAccount, sameOrigin, usernamePattern, validPassword } from '../../lib/account';
const { supabase, user } = await getAccount(Astro.request, Astro.cookies); if(!user||!supabase)return Astro.redirect(`/cuenta/login/?next=${encodeURIComponent('/cuenta/perfil/')}`);
let notice='',error='';
if(Astro.request.method==='POST'){
 const form=await Astro.request.formData(), action=String(form.get('action')??'');
 if(!sameOrigin(Astro.request))error='Solicitud no válida.';
 else if(action==='username'){const username=String(form.get('username')??'').trim();if(!usernamePattern.test(username))error='El usuario no es válido.';else{const result=await supabase.from('profiles').update({username}).eq('user_id',user.id);error=result.error?'Ese nombre no está disponible.':'';notice=error?'':'Nombre actualizado.';}}
 else if(action==='password'||action==='delete-account'){const current=String(form.get('current_password')??'');const auth=await supabase.auth.signInWithPassword({email:user.email??'',password:current});if(auth.error)error='La contraseña actual no es correcta.';else if(action==='password'){const password=String(form.get('password')??'');if(!validPassword(password))error='La nueva contraseña no cumple los requisitos.';else{const result=await supabase.auth.updateUser({password});error=result.error?.message??'';notice=error?'':'Contraseña actualizada.';}}else{const admin=createAdminAuthClient();if(!admin)error='Falta configurar SUPABASE_SECRET_KEY para eliminar cuentas.';else{const result=await admin.auth.admin.deleteUser(user.id);if(result.error)error='No pudimos eliminar la cuenta.';else{await supabase.auth.signOut();return Astro.redirect('/?cuenta=eliminada',303);}}}}
 else if(action==='delete-rating'){const result=await supabase.rpc('delete_game_rating',{p_game_id:String(form.get('game_id')??'')});error=result.error?'No pudimos eliminar la calificación.':'';notice=error?'':'Calificación eliminada.';}
}
const [{data:profile},{data:ratings}]=await Promise.all([supabase.from('profiles').select('username').eq('user_id',user.id).single(),supabase.from('game_ratings').select('game_id,score,updated_at,games(name,slug)').order('updated_at',{ascending:false})]);
type RelatedGame = { name: string; slug: string };
const profileRatings=(ratings??[]).map((rating)=>{
 const relation=rating.games as unknown as RelatedGame|RelatedGame[]|null;
 return {...rating,game:Array.isArray(relation)?relation[0]??null:relation};
});
---
<AccountLayout title="Mi perfil"><div class="profile-stack">{notice&&<p class="form-status" role="status">{notice}</p>}{error&&<p class="form-status is-error" role="alert">{error}</p>}<section><h2>Datos de la cuenta</h2><p><strong>Correo:</strong> {user.email} {user.email_confirmed_at?'· Verificado':'· Pendiente de verificar'}</p><form class="account-form" method="post"><input type="hidden" name="action" value="username"/><label>Nombre de usuario<input name="username" value={profile?.username??''} minlength="3" maxlength="24" pattern="[A-Za-z0-9_]+" required/></label><button class="button button--ghost" type="submit">Guardar nombre</button></form></section><section><h2>Mis calificaciones</h2>{profileRatings.length ? <div class="profile-ratings">{profileRatings.map((rating)=><article><div>{rating.game?<a href={`/juegos/${rating.game.slug}/`}><strong>{rating.game.name}</strong></a>:<strong>Juego no disponible</strong>}<span aria-label={`${rating.score} de 5 estrellas`}>{'★'.repeat(rating.score)}{'☆'.repeat(5-rating.score)}</span></div><form method="post"><input type="hidden" name="action" value="delete-rating"/><input type="hidden" name="game_id" value={rating.game_id}/><button class="text-link" type="submit">Eliminar</button></form></article>)}</div>:<p>Todavía no calificaste ningún juego.</p>}</section><section><h2>Cambiar contraseña</h2><form class="account-form" method="post"><input type="hidden" name="action" value="password"/><label>Contraseña actual<input name="current_password" type="password" autocomplete="current-password" required/></label><label>Nueva contraseña<input name="password" type="password" autocomplete="new-password" minlength="10" required/></label><button class="button button--ghost" type="submit">Cambiar contraseña</button></form></section><section class="danger-zone"><h2>Eliminar cuenta</h2><p>Se eliminarán tu perfil y tus calificaciones de forma definitiva.</p><form class="account-form" method="post" onsubmit="return confirm('¿Eliminar definitivamente tu cuenta y tus datos?')"><input type="hidden" name="action" value="delete-account"/><label>Confirmá tu contraseña<input name="current_password" type="password" autocomplete="current-password" required/></label><button class="button button--danger" type="submit">Eliminar mi cuenta</button></form></section></div></AccountLayout>
