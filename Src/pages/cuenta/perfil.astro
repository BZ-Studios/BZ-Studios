---
export const prerender = false;

import AccountLayout from '../../layouts/AccountLayout.astro';
import PasswordEye from '../../components/PasswordEye.astro';
import { createAdminAuthClient, getAccount, sameOrigin, usernamePattern, validPassword } from '../../lib/account';
import { describeAuthFailure } from '../../lib/auth-errors';
import { MODERATION_ACTION_LABELS, PLAYER_STATUS_LABELS, type BzIdentityPayload } from '../../config/bzId';

const { supabase, user } = await getAccount(Astro.request, Astro.cookies);
if (!user || !supabase) return Astro.redirect(`/cuenta/login/?next=${encodeURIComponent('/cuenta/perfil/')}`);

const dateFormatter = new Intl.DateTimeFormat('es-AR', { dateStyle: 'medium', timeZone: 'America/Argentina/Buenos_Aires' });
const addCalendarMonths = (date: Date, months: number) => {
  const result = new Date(date);
  const originalDay = result.getUTCDate();
  result.setUTCDate(1);
  result.setUTCMonth(result.getUTCMonth() + months);
  const lastDay = new Date(Date.UTC(result.getUTCFullYear(), result.getUTCMonth() + 1, 0)).getUTCDate();
  result.setUTCDate(Math.min(originalDay, lastDay));
  return result;
};
const formatRemainingTime = (milliseconds: number) => {
  const totalHours = Math.max(1, Math.ceil(milliseconds / 3_600_000));
  const totalDays = Math.floor(totalHours / 24);
  const hours = totalHours % 24;
  if (totalDays >= 30) {
    const months = Math.floor(totalDays / 30);
    const days = totalDays % 30;
    return `${months} ${months === 1 ? 'mes' : 'meses'}${days ? ` y ${days} ${days === 1 ? 'día' : 'días'}` : ''}`;
  }
  if (totalDays > 0) return `${totalDays} ${totalDays === 1 ? 'día' : 'días'}${hours ? ` y ${hours} h` : ''}`;
  return `${totalHours} h`;
};
let notice = Astro.url.searchParams.get('notice') ?? '';
let error = '';
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('action') ?? '');
  if (!sameOrigin(Astro.request)) error = 'Solicitud no válida.';
  else if (action === 'username') {
    const username = String(form.get('username') ?? '').trim();
    if (!usernamePattern.test(username)) error = 'Usá entre 3 y 24 letras, números o guiones bajos, sin espacios.';
    else {
      const result = await supabase.rpc('change_username', { candidate: username });
      if (!result.error) notice = 'Nombre actualizado. El próximo cambio estará disponible dentro de tres meses.';
      else if (result.error.message.includes('USERNAME_COOLDOWN')) {
        const availableAt = result.error.message.match(/USERNAME_COOLDOWN:([^\s]+)/)?.[1];
        error = availableAt ? `Podrás volver a cambiar el nombre el ${dateFormatter.format(new Date(availableAt))}.` : 'El cambio de nombre está en período de espera.';
      } else if (result.error.message.includes('USERNAME_UNAVAILABLE')) error = 'Ese nombre no está disponible.';
      else if (result.error.message.includes('ACCOUNT_RESTRICTED')) error = 'Tu cuenta no puede modificar el perfil mientras tenga una restricción activa.';
      else if (result.error.code === 'PGRST202' || result.error.message.includes('change_username')) {
        const legacy = await supabase.from('profiles').update({ username }).eq('user_id', user.id);
        error = legacy.error ? 'Ese nombre no está disponible.' : '';
        notice = error ? '' : 'Nombre actualizado. Aplicá la migración nueva para activar el límite de tres meses.';
      } else error = 'No pudimos cambiar el nombre de usuario.';
    }
  } else if (action === 'appeal') {
    const caseId = String(form.get('case_id') ?? '');
    const message = String(form.get('message') ?? '').trim();
    const { data: player } = await supabase.from('players').select('id').eq('auth_user_id', user.id).maybeSingle();
    if (!player) error = 'Primero debe aplicarse la migración de B&Z ID en Supabase.';
    else if (!caseId || message.length < 20 || message.length > 2000) error = 'La apelación debe explicar el caso en entre 20 y 2000 caracteres.';
    else {
      const result = await supabase.from('moderation_appeals').insert({ case_id: caseId, player_id: player.id, message });
      error = result.error ? (result.error.code === '23505' ? 'Ya existe una apelación abierta para este caso.' : 'No pudimos enviar la apelación.') : '';
      notice = error ? '' : 'Apelación enviada. Podés consultar su estado en esta misma página.';
    }
  } else if (action === 'password' || action === 'delete-account') {
    const current = String(form.get('current_password') ?? '');
    const auth = await supabase.auth.signInWithPassword({ email: user.email ?? '', password: current });
    if (auth.error) error = 'La contraseña actual no es correcta.';
    else if (action === 'password') {
      const password = String(form.get('password') ?? '');
      const confirmation = String(form.get('confirmation') ?? '');
      if (!validPassword(password)) error = 'Usá 8 caracteres como mínimo, mayúscula, minúscula, número y símbolo.';
      else if (password !== confirmation) error = 'Las contraseñas no coinciden.';
      else {
        const result = await supabase.auth.updateUser({ password });
        error = result.error ? describeAuthFailure(result.error, 'No pudimos actualizar la contraseña. Intentá nuevamente.') : '';
        notice = error ? '' : 'Contraseña actualizada.';
      }
    } else {
      const confirmation = String(form.get('confirmation') ?? '');
      if (confirmation !== 'ELIMINAR') error = 'Escribí ELIMINAR para confirmar la solicitud.';
      else {
        const admin = createAdminAuthClient();
        if (!admin) error = 'Falta configurar SUPABASE_SECRET_KEY para eliminar cuentas.';
        else {
          const { data: player } = await admin.from('players').select('id').eq('auth_user_id', user.id).maybeSingle();
          if (player) {
            await admin.from('account_deletion_requests').insert({ player_id: player.id, requested_by: user.id, request_type: 'delete_bz_id', status: 'processing', verified_at: new Date().toISOString() });
            await admin.from('security_audit_events').insert({ player_id: player.id, actor_user_id: user.id, event_type: 'self_service_account_deletion', target_type: 'player', target_id: player.id });
          }
          const result = await admin.auth.admin.deleteUser(user.id);
          if (result.error) error = 'No pudimos eliminar la cuenta.';
          else {
            await supabase.auth.signOut();
            return Astro.redirect('/?cuenta=eliminada', 303);
          }
        }
      }
    }
  } else if (action === 'delete-rating') {
    const result = await supabase.rpc('delete_game_rating', { p_game_id: String(form.get('game_id') ?? '') });
    error = result.error ? 'No pudimos eliminar la calificación.' : '';
    notice = error ? '' : 'Calificación eliminada.';
  }
}

let profileResult = await supabase.from('profiles').select('username,username_change_count,username_changed_at').eq('user_id', user.id).single();
if (profileResult.error) profileResult = await supabase.from('profiles').select('username').eq('user_id', user.id).single() as typeof profileResult;
const [{ data: ratings }, identityResult] = await Promise.all([
  supabase.from('game_ratings').select('game_id,score,updated_at,games(name,slug)').order('updated_at', { ascending: false }),
  supabase.rpc('get_my_bz_id_data'),
]);

type RelatedGame = { name: string; slug: string };
const profileRatings = (ratings ?? []).map((rating) => {
  const relation = rating.games as unknown as RelatedGame | RelatedGame[] | null;
  return { ...rating, game: Array.isArray(relation) ? relation[0] ?? null : relation };
});
const profile = profileResult.data as { username?: string; username_change_count?: number; username_changed_at?: string | null } | null;
const bzId = (!identityResult.error && identityResult.data ? identityResult.data : null) as BzIdentityPayload | null;
const identityReady = Boolean(bzId?.identity);
const activeAppealCases = new Set((bzId?.appeals ?? []).filter((appeal) => ['submitted', 'under_review'].includes(appeal.status)).map((appeal) => appeal.caseId));
const usernameChangedAt = profile?.username_changed_at ? new Date(profile.username_changed_at) : null;
const nextUsernameChange = profile?.username_change_count && usernameChangedAt ? addCalendarMonths(usernameChangedAt, 3) : null;
const usernameLocked = Boolean(nextUsernameChange && nextUsernameChange > new Date());
const usernameCooldownTotal = usernameChangedAt && nextUsernameChange ? nextUsernameChange.getTime() - usernameChangedAt.getTime() : 0;
const usernameCooldownElapsed = usernameChangedAt ? Date.now() - usernameChangedAt.getTime() : 0;
const usernameCooldownProgress = usernameLocked && usernameCooldownTotal > 0
  ? Math.min(100, Math.max(0, (usernameCooldownElapsed / usernameCooldownTotal) * 100))
  : 100;
const usernameRemainingLabel = usernameLocked && nextUsernameChange
  ? formatRemainingTime(nextUsernameChange.getTime() - Date.now())
  : 'Disponible ahora';
---
<AccountLayout title="Mi B&Z ID" description="Administrá tu identidad de jugador, seguridad, juegos vinculados, calificaciones y derechos de privacidad.">
  <div class="profile-stack">
    {notice && <p class="form-status" role="status">{notice}</p>}
    {error && <p class="form-status is-error" role="alert">{error}</p>}

    <section class="identity-hero">
      <div><p class="kicker">Identidad central</p><h2>{bzId?.identity.publicId ?? 'B&Z ID pendiente'}</h2><p>Tu identidad central para el sitio y, más adelante, para los videojuegos oficiales de B&Z Studios.</p></div>
      <span class:list={['identity-status', `is-${bzId?.identity.status ?? 'pending'}`]}>{identityReady ? PLAYER_STATUS_LABELS[bzId!.identity.status] : 'Requiere migración'}</span>
    </section>
    {!identityReady && <p class="identity-note"><strong>Configuración pendiente:</strong> tu cuenta actual sigue funcionando. Para activar B&Z ID hay que ejecutar la migración correspondiente en Supabase.</p>}

    <section>
      <div class="profile-section-heading"><div><p class="kicker">Identidad</p><h2>Datos de la cuenta</h2></div><a class="button button--ghost button--small" href="/cuenta/exportar.json">Exportar mis datos</a></div>
      <dl class="identity-details">
        <div><dt>Correo</dt><dd>{user.email} <small>{user.email_confirmed_at ? 'Verificado' : 'Pendiente de verificar'}</small></dd></div>
        <div><dt>Estado</dt><dd>{identityReady ? PLAYER_STATUS_LABELS[bzId!.identity.status] : 'Cuenta web activa'}</dd></div>
        {bzId?.identity.createdAt && <div><dt>Creación</dt><dd>{dateFormatter.format(new Date(bzId.identity.createdAt))}</dd></div>}
      </dl>
      <div class:list={['username-change-panel', { 'is-locked': usernameLocked }]} style={`--username-cooldown-progress:${usernameCooldownProgress}%`}>
        <div class="username-change-panel__heading">
          <div><span class="username-change-panel__eyebrow">Cambio de nombre</span><strong>{usernameLocked ? 'Tiempo de espera activo' : 'Cambio disponible'}</strong></div>
          <span class:list={['username-change-status', { 'is-ready': !usernameLocked }]}>{usernameRemainingLabel}</span>
        </div>
        <div class="username-change-meter" aria-label={usernameLocked ? `Progreso de la espera: ${Math.round(usernameCooldownProgress)}%` : 'Cambio de nombre disponible'}><span aria-hidden="true"></span></div>
        <div class="username-change-timing">
          <span>{usernameLocked ? 'Espera entre cambios' : profile?.username_change_count ? 'Tiempo de espera completado' : 'Primer cambio sin espera previa'}</span>
          {usernameLocked && nextUsernameChange
            ? <time datetime={nextUsernameChange.toISOString()} data-username-countdown data-available-at={nextUsernameChange.toISOString()}>{`Se habilita el ${dateFormatter.format(nextUsernameChange)}`}</time>
            : <span>Después deberás esperar tres meses</span>}
        </div>
        <form class="account-form username-change-form" id="username-change-form" method="post" data-username-change-form data-current-username={profile?.username ?? ''}>
          <input type="hidden" name="action" value="username" />
          <label>Nuevo nombre de usuario
            <input name="username" value={profile?.username ?? ''} minlength="3" maxlength="24" pattern="[A-Za-z0-9_]+" autocomplete="username" spellcheck="false" disabled={usernameLocked} data-profile-username required />
            <small>Usá entre 3 y 24 letras, números o guiones bajos, sin espacios.</small>
            <span class="field-feedback" data-profile-username-feedback aria-live="polite"></span>
          </label>
          <button class="username-change-action" type="button" disabled data-modal-open="username-change-dialog" data-username-change-action>
            <span>{usernameLocked ? 'CAMBIO BLOQUEADO' : 'CAMBIAR NOMBRE'}</span>
            <small>{usernameLocked ? <><span aria-hidden="true">◷</span> Esperá {usernameRemainingLabel}</> : <><span aria-hidden="true">✓</span> Disponible ahora</>}</small>
          </button>
        </form>
      </div>
      {!usernameLocked && <dialog class="site-dialog username-change-dialog" id="username-change-dialog" data-modal-dialog aria-labelledby="username-change-title">
        <p class="kicker">Confirmar identidad</p>
        <h2 id="username-change-title">¿Cambiar tu nombre?</h2>
        <p>Tu nuevo nombre público será <strong data-username-change-preview>{profile?.username ?? ''}</strong>.</p>
        <p>Después de confirmarlo comenzará una espera de <strong>tres meses</strong>. Durante ese período no podrás volver a modificarlo.</p>
        <div class="site-dialog__actions"><button class="button button--ghost" type="button" data-modal-close>Cancelar</button><button class="button" type="button" data-username-change-confirm>Confirmar cambio</button></div>
      </dialog>}
    </section>

    <section class="profile-settings">
      <p class="kicker">Control de cuenta</p><h2>Ajustes</h2>
      <div class="profile-disclosures">
        <details class="profile-disclosure">
          <summary><span>Mis calificaciones <small>{profileRatings.length} {profileRatings.length === 1 ? 'juego' : 'juegos'}</small></span><i aria-hidden="true"></i></summary>
          <div class="profile-disclosure__content">{profileRatings.length ? <div class="profile-ratings">{profileRatings.map((rating) => <article><div>{rating.game ? <a href={`/juegos/${rating.game.slug}/`}><strong>{rating.game.name}</strong></a> : <strong>Juego no disponible</strong>}<span aria-label={`${rating.score} de 5 estrellas`}>{'★'.repeat(rating.score)}{'☆'.repeat(5 - rating.score)}</span></div><form method="post"><input type="hidden" name="action" value="delete-rating" /><input type="hidden" name="game_id" value={rating.game_id} /><button class="text-link" type="submit">Eliminar</button></form></article>)}</div> : <p>Todavía no calificaste ningún juego.</p>}</div>
        </details>

        <details class="profile-disclosure">
          <summary><span>Vinculación de cuentas <small>Juegos asociados a tu B&Z ID</small></span><i aria-hidden="true"></i></summary>
          <div class="profile-disclosure__content">{bzId?.gameAccounts.length ? <div class="linked-games">{bzId.gameAccounts.map((account) => <article><div><strong>{account.gameName}</strong><span>{account.displayName || account.platform}</span></div><span class="identity-status">{account.status}</span></article>)}</div> : <div class="identity-empty"><strong>No hay juegos vinculados</strong><p>La vinculación se habilitará juego por juego mediante un código temporal generado por el servidor oficial. No te pediremos la contraseña del juego.</p><button class="button button--ghost" type="button" disabled>Vincular un juego · próximamente</button></div>}</div>
        </details>

        <details class="profile-disclosure">
          <summary><span>Estado del perfil <small>Moderación y apelaciones</small></span><i aria-hidden="true"></i></summary>
          <div class="profile-disclosure__content">{bzId?.moderation.length ? <div class="moderation-list">{bzId.moderation.map((measure) => <article><div><strong>{MODERATION_ACTION_LABELS[measure.action] ?? measure.action}</strong><p>{measure.message}</p><small>Alcance: {measure.scope} · Desde {dateFormatter.format(new Date(measure.startsAt))}{measure.endsAt ? ` hasta ${dateFormatter.format(new Date(measure.endsAt))}` : ''}</small></div>{measure.caseId && !activeAppealCases.has(measure.caseId) && <form class="account-form appeal-form" method="post"><input type="hidden" name="action" value="appeal" /><input type="hidden" name="case_id" value={measure.caseId} /><label>Explicá tu apelación<textarea name="message" minlength="20" maxlength="2000" rows="4" required></textarea></label><button class="button button--ghost button--small" type="submit">Enviar apelación</button></form>}</article>)}</div> : <p class="identity-empty">No tenés medidas de moderación activas.</p>}{bzId?.appeals.length ? <div class="appeal-history"><h3>Historial de apelaciones</h3>{bzId.appeals.map((appeal) => <article><strong>{appeal.status.replace('_', ' ')}</strong><p>{appeal.message}</p>{appeal.decision && <small>Resolución: {appeal.decision}</small>}</article>)}</div> : null}</div>
        </details>

        <details class="profile-disclosure">
          <summary><span>Cambiar contraseña <small>Actualizá tus credenciales</small></span><i aria-hidden="true"></i></summary>
          <div class="profile-disclosure__content"><form class="account-form" method="post" data-password-form novalidate><input type="hidden" name="action" value="password" /><label>Contraseña actual<div class="account-password-control"><input id="profile-current-password" name="current_password" type="password" autocomplete="off" data-manual-password data-1p-ignore data-lpignore="true" readonly required /><button type="button" data-password-toggle aria-controls="profile-current-password" aria-label="Mostrar contraseña" aria-pressed="false"><PasswordEye /></button></div><small>Por seguridad, ingresala manualmente.</small></label><label>Nueva contraseña<div class="account-password-control"><input id="profile-new-password" name="password" type="password" autocomplete="new-password" minlength="8" data-password required /><button type="button" data-password-toggle aria-controls="profile-new-password" aria-label="Mostrar contraseña" aria-pressed="false"><PasswordEye /></button></div><small>8 caracteres como mínimo, con mayúscula, minúscula, número y símbolo.</small><span class="field-feedback" data-password-feedback aria-live="polite"></span></label><label>Confirmar nueva contraseña<div class="account-password-control"><input id="profile-password-confirmation" name="confirmation" type="password" autocomplete="new-password" minlength="8" data-password-confirmation required /><button type="button" data-password-toggle aria-controls="profile-password-confirmation" aria-label="Mostrar contraseña" aria-pressed="false"><PasswordEye /></button></div><span class="field-feedback" data-confirmation-feedback aria-live="polite"></span></label><button class="button button--ghost" type="submit">Cambiar contraseña</button><a class="text-link" href="/cuenta/recuperar/">¿Olvidaste tu contraseña actual?</a></form></div>
        </details>

        <details class="profile-disclosure danger-zone">
          <summary><span>Eliminar B&Z ID <small>Acción permanente</small></span><i aria-hidden="true"></i></summary>
          <div class="profile-disclosure__content"><p>Esta acción elimina la identidad central, el perfil web, las vinculaciones y las calificaciones. Algunos registros mínimos pueden conservarse por seguridad o cumplimiento.</p><form class="account-form" method="post" onsubmit="return confirm('¿Eliminar definitivamente tu B&Z ID y los datos asociados?')"><input type="hidden" name="action" value="delete-account" /><label>Contraseña actual<div class="account-password-control"><input id="delete-current-password" name="current_password" type="password" autocomplete="off" data-manual-password data-1p-ignore data-lpignore="true" readonly required /><button type="button" data-password-toggle aria-controls="delete-current-password" aria-label="Mostrar contraseña" aria-pressed="false"><PasswordEye /></button></div></label><label>Escribí ELIMINAR<input name="confirmation" pattern="ELIMINAR" autocomplete="off" required /></label><button class="button button--danger" type="submit">Eliminar mi B&Z ID</button></form></div>
        </details>
      </div>
    </section>
  </div>
</AccountLayout>

<script>
  const usernameForm = document.querySelector<HTMLFormElement>('[data-username-change-form]');
  const usernameInput = usernameForm?.querySelector<HTMLInputElement>('[data-profile-username]');
  const usernameFeedback = usernameForm?.querySelector<HTMLElement>('[data-profile-username-feedback]');
  const usernameAction = usernameForm?.querySelector<HTMLButtonElement>('[data-username-change-action]');
  const usernameDialog = document.getElementById('username-change-dialog') as HTMLDialogElement | null;
  const usernamePreview = usernameDialog?.querySelector<HTMLElement>('[data-username-change-preview]');
  const usernameConfirm = usernameDialog?.querySelector<HTMLButtonElement>('[data-username-change-confirm]');
  const originalUsername = usernameForm?.dataset.currentUsername ?? '';
  let usernameChangeConfirmed = false;

  const syncUsernameChange = () => {
    if (!usernameInput || !usernameAction) return;
    const candidate = usernameInput.value.trim();
    const formatValid = /^[A-Za-z0-9_]{3,24}$/.test(candidate);
    const changed = candidate.toLocaleLowerCase() !== originalUsername.toLocaleLowerCase();
    const message = !candidate || formatValid
      ? changed ? '' : 'Ingresá un nombre diferente al actual.'
      : /\s/.test(candidate) ? 'El nombre no puede contener espacios.' : 'Usá solamente letras, números o guiones bajos.';
    usernameInput.setCustomValidity(message);
    usernameInput.classList.toggle('is-invalid', Boolean(candidate && message));
    usernameInput.setAttribute('aria-invalid', String(Boolean(candidate && message)));
    if (usernameFeedback) usernameFeedback.textContent = candidate ? message : '';
    usernameAction.disabled = !formatValid || !changed;
    if (usernamePreview) usernamePreview.textContent = candidate || originalUsername;
  };

  usernameInput?.addEventListener('input', syncUsernameChange);
  usernameForm?.addEventListener('submit', (event) => {
    if (usernameChangeConfirmed) return;
    event.preventDefault();
    syncUsernameChange();
    if (!usernameForm.reportValidity()) return;
    usernameDialog?.showModal();
    document.documentElement.setAttribute('data-modal-open', '');
  });
  usernameConfirm?.addEventListener('click', () => {
    if (!usernameForm || !usernameInput) return;
    syncUsernameChange();
    if (!usernameForm.reportValidity()) return;
    usernameChangeConfirmed = true;
    usernameDialog?.close();
    usernameForm.requestSubmit();
  });
  syncUsernameChange();

  const countdown = document.querySelector<HTMLElement>('[data-username-countdown]');
  const availableAt = countdown?.dataset.availableAt ? new Date(countdown.dataset.availableAt).getTime() : 0;
  if (countdown && availableAt) {
    const refreshAvailability = () => {
      const remaining = availableAt - Date.now();
      if (remaining <= 0) {
        window.location.reload();
        return;
      }
      const totalHours = Math.max(1, Math.ceil(remaining / 3_600_000));
      const days = Math.floor(totalHours / 24);
      const hours = totalHours % 24;
      countdown.title = `Faltan ${days ? `${days} ${days === 1 ? 'día' : 'días'}` : ''}${days && hours ? ' y ' : ''}${hours ? `${hours} h` : ''}`;
    };
    refreshAvailability();
    window.setInterval(refreshAvailability, 60_000);
  }
</script>
