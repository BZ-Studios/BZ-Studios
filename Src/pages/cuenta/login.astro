---
import AccountLayout from '../../layouts/AccountLayout.astro';
import PasswordEye from '../../components/PasswordEye.astro';
import { createAdminAuthClient, getAccount, safeNext, sameOrigin } from '../../lib/account';
import { MODERATION_ACTION_LABELS, MODERATION_SCOPE_LABELS, type ModerationActionType } from '../../config/bzId';
const { supabase, user } = await getAccount(Astro.request, Astro.cookies);
const next = safeNext(Astro.url.searchParams.get('next'));
if (user) return Astro.redirect(next);
const dateFormatter = new Intl.DateTimeFormat('es-AR', { dateStyle: 'long', timeStyle: 'short', timeZone: 'America/Argentina/Buenos_Aires' });
type SuspensionNotice = { publicId: string; action: ModerationActionType; message: string; reason: string; scope: string; endsAt: string | null };
let suspension: SuspensionNotice | null = null;
let error = Astro.url.searchParams.has('error')
  ? 'El enlace no pudo validarse o ya venció. Solicitá uno nuevo e intentá otra vez.'
  : '';
if (Astro.request.method === 'POST') {
  if (!sameOrigin(Astro.request)) error = 'Solicitud no válida.';
  else {
    const form = await Astro.request.formData();
    const email = String(form.get('email') ?? '').trim();
    const password = String(form.get('password') ?? '');
    const result = await supabase?.auth.signInWithPassword({ email, password });
    if (!result || result.error || !result.data.user?.email_confirmed_at) {
      await supabase?.auth.signOut();
      const authCode = String((result?.error as { code?: string } | undefined)?.code ?? '');
      const isBanned = /bann|suspend/i.test(`${authCode} ${result?.error?.message ?? ''}`);
      if (isBanned) {
        const admin = createAdminAuthClient();
        const usersResult = await admin?.auth.admin.listUsers({ page: 1, perPage: 1000 });
        const authUser = usersResult?.data.users.find((candidate) => candidate.email?.toLocaleLowerCase() === email.toLocaleLowerCase());
        if (admin && authUser) {
          const { data: player } = await admin.from('players').select('id,public_id').eq('auth_user_id', authUser.id).maybeSingle();
          if (player) {
            const { data: measure } = await admin.from('moderation_actions')
              .select('action_type,user_message,reason_code,scope_type,ends_at')
              .eq('player_id', player.id)
              .is('revoked_at', null)
              .in('action_type', ['temporary_suspension', 'indefinite_ban', 'global_ban'])
              .or(`ends_at.is.null,ends_at.gt.${new Date().toISOString()}`)
              .order('created_at', { ascending: false })
              .limit(1)
              .maybeSingle();
            if (measure) suspension = {
              publicId: player.public_id,
              action: measure.action_type as ModerationActionType,
              message: measure.user_message,
              reason: measure.reason_code.replaceAll('_', ' '),
              scope: MODERATION_SCOPE_LABELS[measure.scope_type] ?? 'Toda tu cuenta B&Z',
              endsAt: measure.ends_at,
            };
          }
        }
        error = suspension ? '' : 'Tu cuenta está suspendida. Contactá a soporte para revisar la medida.';
      } else error = 'No pudimos iniciar sesión. Revisá tus datos y verificá tu correo.';
    } else return Astro.redirect(safeNext(String(form.get('next') ?? '')), 303);
  }
}
const appealMessage = suspension ? `Quiero apelar la medida aplicada a ${suspension.publicId}. Motivo informado: ${suspension.reason}.` : '';
---

<AccountLayout title="Iniciar sesión">
  <form class="account-form" method="post">
    <input type="hidden" name="next" value={next}/>
    {error && <p class="form-status is-error" role="alert">{error}</p>}
    <div class="account-field"><label for="login-email">Correo electrónico</label><input id="login-email" name="email" type="email" autocomplete="email" required /></div>
    <div class="account-field"><label for="login-password">Contraseña</label><div class="account-password-control"><input id="login-password" name="password" type="password" autocomplete="current-password" required /><button type="button" data-password-toggle aria-controls="login-password" aria-label="Mostrar contraseña" aria-pressed="false"><PasswordEye /></button></div></div>
    <button class="button button--primary" type="submit">Ingresar</button>
    <a class="button button--ghost" href={`/cuenta/bz-id/?next=${encodeURIComponent(next)}`}>Entrar con código B&Z ID</a>
    <a class="text-link" href="/cuenta/recuperar/">¿Olvidaste tu contraseña?</a>
    <p>¿Todavía no tenés cuenta? <a href={`/cuenta/registro/?next=${encodeURIComponent(next)}`}>Registrate</a>.</p>
  </form>
  {suspension && <dialog class="site-dialog account-suspension-dialog" id="account-suspension-dialog" data-modal-dialog aria-labelledby="account-suspension-title">
    <div class="account-suspension-dialog__heading"><div><p class="kicker">Acceso restringido</p><h2 id="account-suspension-title">Tu cuenta está suspendida</h2></div><span aria-hidden="true">!</span></div>
    <p class="account-suspension-dialog__message">{suspension.message}</p>
    <dl class="account-suspension-details">
      <div><dt>Medida</dt><dd>{MODERATION_ACTION_LABELS[suspension.action]}</dd></div>
      <div><dt>Motivo</dt><dd>{suspension.reason}</dd></div>
      <div><dt>Alcance</dt><dd>{suspension.scope}</dd></div>
      <div><dt>Duración</dt><dd>{suspension.endsAt ? `Hasta el ${dateFormatter.format(new Date(suspension.endsAt))}` : 'Sin fecha de finalización'}</dd></div>
      <div><dt>B&Z ID</dt><dd>{suspension.publicId}</dd></div>
      <div><dt>Soporte</dt><dd><a href="mailto:bzstudios.games@gmail.com">bzstudios.games@gmail.com</a></dd></div>
    </dl>
    <p class="account-suspension-dialog__help">Podés apelar la decisión. No envíes tu contraseña ni otros datos sensibles.</p>
    <div class="site-dialog__actions"><a class="button button--ghost" href={`/contacto/?categoria=${encodeURIComponent('Apelación')}&mensaje=${encodeURIComponent(appealMessage)}`}>Apelar medida</a><button class="button button--primary" type="button" data-modal-close>Aceptar</button></div>
  </dialog>}
</AccountLayout>

{suspension && <script>
  const suspensionDialog = document.querySelector<HTMLDialogElement>('#account-suspension-dialog');
  if (suspensionDialog && !suspensionDialog.open) suspensionDialog.showModal();
</script>}
