---
import AccountLayout from '../../layouts/AccountLayout.astro';
import LegalDocument from '../../components/LegalDocument.astro';
import PasswordEye from '../../components/PasswordEye.astro';
import { accountRedirectUrl, getAccount, safeNext, sameOrigin, usernamePattern, validPassword } from '../../lib/account';
import { describeSignupFailure, reportRegistrationFailure } from '../../lib/auth-diagnostics';
import { privacyDocument, termsDocument } from '../../config/legal';

const { supabase, user } = await getAccount(Astro.request, Astro.cookies);
const next = safeNext(Astro.url.searchParams.get('next'));
if (user) return Astro.redirect(next);

let error = '';
let diagnosticId = '';
let username = '';
let email = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  username = String(form.get('username') ?? '').trim();
  email = String(form.get('email') ?? '').trim();
  const password = String(form.get('password') ?? '');
  const confirmation = String(form.get('confirmation') ?? '');

  if (!sameOrigin(Astro.request) || form.get('website')) error = 'No pudimos procesar el registro.';
  else if (!usernamePattern.test(username)) error = 'El usuario debe tener entre 3 y 24 letras, números o guiones bajos, sin espacios.';
  else if (!validPassword(password)) error = 'La contraseña debe tener 8 caracteres como mínimo, mayúscula, minúscula, número y símbolo.';
  else if (password !== confirmation) error = 'Las contraseñas no coinciden.';
  else if (form.get('terms') !== 'on') error = 'Debés aceptar los términos y la política de privacidad.';
  else if (!supabase) error = 'El servicio de cuentas no está disponible en este momento.';
  else {
    const available = await supabase.rpc('username_available', { candidate: username });
    if (available.error) {
      diagnosticId = reportRegistrationFailure('username-check', available.error);
      error = 'No pudimos comprobar el nombre de usuario. Intentá nuevamente más tarde.';
    }
    else if (!available.data) error = 'Ese nombre de usuario no está disponible.';
    else {
      const result = await supabase.auth.signUp({
        email,
        password,
        options: {
          emailRedirectTo: accountRedirectUrl(`/cuenta/verificar/?next=${encodeURIComponent(next)}`),
          data: { username, terms_accepted_at: new Date().toISOString() },
        },
      });
      if (result.error) {
        diagnosticId = reportRegistrationFailure('signup', result.error);
        error = describeSignupFailure(result.error);
      }
      else {
        Astro.cookies.set('pending_signup_email', email, { httpOnly: true, sameSite: 'strict', secure: import.meta.env.PROD, path: '/cuenta/', maxAge: 60 * 60 });
        return Astro.redirect(`/cuenta/verificar/?next=${encodeURIComponent(next)}`, 303);
      }
    }
  }
}
---

<AccountLayout title="Crear cuenta">
  <form class="account-form" method="post" data-registration-form data-password-form novalidate>
    <input class="hp-field" name="website" tabindex="-1" autocomplete="off" />
    {error && <div class="form-status is-error" role="alert"><p>{error}</p>{diagnosticId && <small class="form-diagnostic">Código de diagnóstico: <code>{diagnosticId}</code></small>}</div>}
    <>
      <div class="account-field">
        <label for="username">Nombre de usuario</label>
        <input id="username" name="username" value={username} autocomplete="username" minlength="3" maxlength="24" pattern="[A-Za-z0-9_]{3,24}" spellcheck="false" data-username required />
        <small>3 a 24 letras, números o guiones bajos. No se permiten espacios.</small>
        <span class="field-feedback" data-username-feedback aria-live="polite"></span>
      </div>
      <div class="account-field"><label for="email">Correo electrónico</label><input id="email" name="email" value={email} type="email" autocomplete="email" required /></div>
      <div class="account-field">
        <label for="register-password">Contraseña</label>
        <div class="account-password-control"><input id="register-password" name="password" type="password" autocomplete="new-password" minlength="8" data-password required /><button type="button" data-password-toggle aria-controls="register-password" aria-label="Mostrar contraseña" aria-pressed="false"><PasswordEye /></button></div>
        <small>8 caracteres como mínimo, con mayúscula, minúscula, número y símbolo.</small>
        <span class="field-feedback" data-password-feedback aria-live="polite"></span>
      </div>
      <div class="account-field">
        <label for="register-confirmation">Confirmar contraseña</label>
        <div class="account-password-control"><input id="register-confirmation" name="confirmation" type="password" autocomplete="new-password" minlength="8" data-password-confirmation required /><button type="button" data-password-toggle aria-controls="register-confirmation" aria-label="Mostrar contraseña" aria-pressed="false"><PasswordEye /></button></div>
        <span class="field-feedback" data-confirmation-feedback aria-live="polite"></span>
      </div>
      <div class="account-terms"><label class="account-check"><input name="terms" type="checkbox" data-terms required /><span>Acepto los <button class="account-legal-trigger" type="button" data-modal-open="terms-dialog">términos y condiciones</button> y la <button class="account-legal-trigger" type="button" data-modal-open="privacy-dialog">política de privacidad</button>.</span></label><span class="field-feedback is-error" data-terms-feedback aria-live="polite"></span></div>
      <button class="button button--primary" type="submit">Crear cuenta</button>
    </>
  </form>

  <dialog class="account-legal-dialog" id="terms-dialog" data-modal-dialog aria-labelledby="terms-dialog-title">
    <div class="account-legal-dialog__heading"><div><p class="kicker">{termsDocument.eyebrow}</p><h2 id="terms-dialog-title">{termsDocument.title}</h2></div><button type="button" data-modal-close aria-label="Cerrar términos">×</button></div>
    <div class="account-legal-dialog__body"><LegalDocument document={termsDocument} compact /></div>
    <button class="button button--primary" type="button" data-modal-close>Entendido</button>
  </dialog>
  <dialog class="account-legal-dialog" id="privacy-dialog" data-modal-dialog aria-labelledby="privacy-dialog-title">
    <div class="account-legal-dialog__heading"><div><p class="kicker">{privacyDocument.eyebrow}</p><h2 id="privacy-dialog-title">{privacyDocument.title}</h2></div><button type="button" data-modal-close aria-label="Cerrar política de privacidad">×</button></div>
    <div class="account-legal-dialog__body"><LegalDocument document={privacyDocument} compact /></div>
    <button class="button button--primary" type="button" data-modal-close>Entendido</button>
  </dialog>
</AccountLayout>
