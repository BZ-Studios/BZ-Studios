---
import AccountLayout from '../../layouts/AccountLayout.astro';
import LegalDocument from '../../components/LegalDocument.astro';
import { accountRedirectUrl, getAccount, safeNext, sameOrigin, usernamePattern, validPassword } from '../../lib/account';
import { privacyDocument, termsDocument } from '../../config/legal';

const { supabase, user } = await getAccount(Astro.request, Astro.cookies);
const next = safeNext(Astro.url.searchParams.get('next'));
if (user) return Astro.redirect(next);

let error = '';
let sent = false;
let username = '';
let email = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  username = String(form.get('username') ?? '').trim();
  email = String(form.get('email') ?? '').trim();
  const password = String(form.get('password') ?? '');
  const confirmation = String(form.get('confirmation') ?? '');

  if (!sameOrigin(Astro.request) || form.get('website')) error = 'No pudimos procesar el registro.';
  else if (!usernamePattern.test(username)) error = 'El usuario debe tener entre 3 y 24 letras, números o guiones bajos, sin espacios.';
  else if (!validPassword(password)) error = 'La contraseña debe tener 8 caracteres como mínimo, mayúscula, minúscula, número y símbolo.';
  else if (password !== confirmation) error = 'Las contraseñas no coinciden.';
  else if (form.get('terms') !== 'on') error = 'Debés aceptar los términos y la política de privacidad.';
  else if (!supabase) error = 'El servicio de cuentas no está disponible en este momento.';
  else {
    const available = await supabase.rpc('username_available', { candidate: username });
    if (available.error || !available.data) error = 'Ese nombre de usuario no está disponible.';
    else {
      const result = await supabase.auth.signUp({
        email,
        password,
        options: {
          emailRedirectTo: accountRedirectUrl(`/cuenta/callback/?next=${encodeURIComponent(next)}`),
          data: { username, terms_accepted_at: new Date().toISOString() },
        },
      });
      if (result.error) error = result.error.message.includes('rate')
        ? 'Demasiados intentos. Esperá unos minutos.'
        : 'No pudimos crear la cuenta. Revisá los datos e intentá nuevamente.';
      else sent = true;
    }
  }
}
---

<AccountLayout title="Crear cuenta">
  <form class="account-form" method="post" data-registration-form data-password-form novalidate>
    <input class="hp-field" name="website" tabindex="-1" autocomplete="off" />
    {error && <p class="form-status is-error" role="alert">{error}</p>}
    {sent && <div class="account-notice" role="status"><strong>Revisá tu correo</strong><p>Te enviamos un enlace de confirmación que vuelve a <strong>bzstudios.com.ar</strong>. Abrilo para activar tu cuenta; después podrás iniciar sesión y calificar juegos.</p></div>}
    {!sent && <>
      <div class="account-field">
        <label for="username">Nombre de usuario</label>
        <input id="username" name="username" value={username} autocomplete="username" minlength="3" maxlength="24" pattern="[A-Za-z0-9_]{3,24}" spellcheck="false" data-username required />
        <small>3 a 24 letras, números o guiones bajos. No se permiten espacios.</small>
        <span class="field-feedback" data-username-feedback aria-live="polite"></span>
      </div>
      <div class="account-field"><label for="email">Correo electrónico</label><input id="email" name="email" value={email} type="email" autocomplete="email" required /></div>
      <div class="account-field">
        <label for="register-password">Contraseña</label>
        <div class="account-password-control"><input id="register-password" name="password" type="password" autocomplete="new-password" minlength="8" data-password required /><button type="button" data-password-toggle aria-controls="register-password" aria-label="Mostrar contraseña" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"/><circle cx="12" cy="12" r="2.8"/></svg></button></div>
        <small>8 caracteres como mínimo, con mayúscula, minúscula, número y símbolo.</small>
        <span class="field-feedback" data-password-feedback aria-live="polite"></span>
      </div>
      <div class="account-field">
        <label for="register-confirmation">Confirmar contraseña</label>
        <div class="account-password-control"><input id="register-confirmation" name="confirmation" type="password" autocomplete="new-password" minlength="8" data-password-confirmation required /><button type="button" data-password-toggle aria-controls="register-confirmation" aria-label="Mostrar contraseña" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"/><circle cx="12" cy="12" r="2.8"/></svg></button></div>
        <span class="field-feedback" data-confirmation-feedback aria-live="polite"></span>
      </div>
      <label class="account-check"><input name="terms" type="checkbox" required /><span>Acepto los <button class="account-legal-trigger" type="button" data-legal-open="terms-dialog">términos y condiciones</button> y la <button class="account-legal-trigger" type="button" data-legal-open="privacy-dialog">política de privacidad</button>.</span></label>
      <button class="button button--primary" type="submit">Crear cuenta</button>
    </>}
  </form>

  <dialog class="account-legal-dialog" id="terms-dialog" data-legal-dialog aria-labelledby="terms-dialog-title">
    <div class="account-legal-dialog__heading"><div><p class="kicker">{termsDocument.eyebrow}</p><h2 id="terms-dialog-title">{termsDocument.title}</h2></div><button type="button" data-legal-close aria-label="Cerrar términos">×</button></div>
    <div class="account-legal-dialog__body"><LegalDocument document={termsDocument} compact /></div>
    <button class="button button--primary" type="button" data-legal-close>Entendido</button>
  </dialog>
  <dialog class="account-legal-dialog" id="privacy-dialog" data-legal-dialog aria-labelledby="privacy-dialog-title">
    <div class="account-legal-dialog__heading"><div><p class="kicker">{privacyDocument.eyebrow}</p><h2 id="privacy-dialog-title">{privacyDocument.title}</h2></div><button type="button" data-legal-close aria-label="Cerrar política de privacidad">×</button></div>
    <div class="account-legal-dialog__body"><LegalDocument document={privacyDocument} compact /></div>
    <button class="button button--primary" type="button" data-legal-close>Entendido</button>
  </dialog>
</AccountLayout>
