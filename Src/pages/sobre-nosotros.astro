---
import BaseLayout from '../layouts/BaseLayout.astro';
import { content } from '../config/content';
import { getPublicMembers } from '../lib/members';

const members = await getPublicMembers();
---

<BaseLayout title="Estudio independiente de videojuegos" description="Conocé B&Z Studios, un estudio independiente de videojuegos de Argentina creado por Luis Zabala y Agustín Bustamante.">
  <section class="page-hero page-hero--about">
    <div class="shell split-hero">
      <div>
        <p class="kicker">Sobre B&Z</p>
        <h1>{content.about.title}</h1>
      </div>
      <p class="lead">{content.about.intro}</p>
    </div>
  </section>
  <section class="section team-section">
    <div class="shell member-grid">
      {members.map((member, index) => (
        <article class="member-card">
          <span class="member-card__number" aria-hidden="true">0{index + 1}</span>
          <div class="member-card__avatar" aria-hidden="true">{member.name.split(' ').map((part) => part[0]).join('')}</div>
          <div class="member-card__content">
            <h2>{member.name}</h2>
            <p>{member.role}</p>
            {member.instagramUrl && (
              <a class="member-card__social" href={member.instagramUrl} target="_blank" rel="noreferrer" aria-label={`Instagram de ${member.name}`}>
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="1"></circle></svg>
                Ver Instagram <span aria-hidden="true">↗</span>
              </a>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>
  <section class="section manifesto">
    <div class="shell manifesto__grid">
      <p class="kicker">Nuestra forma de crear</p>
      <h2>El rol cambia.<br />La meta no.</h2>
      <div>
        <p>No trabajamos con cargos rígidos. Nos involucramos en las distintas partes del proceso según lo que cada proyecto necesita.</p>
        <p>Hoy desarrollamos principalmente para la web; mañana pueden cambiar las herramientas y las plataformas. La curiosidad por hacer buenos juegos se queda.</p>
      </div>
    </div>
  </section>
</BaseLayout>
