---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import Inbox from '../../components/admin/Inbox.astro';
import { getAdminSession } from '../../lib/admin';
import { createAdminAuthClient } from '../../lib/account';
import { fallbackMembers } from '../../lib/members';
import { GAME_GENRES } from '../../config/gameGenres';
import { GAME_STATUSES } from '../../types/game';

const session = await getAdminSession(Astro.request, Astro.cookies);
if (!session.user || !session.isAdmin || !session.supabase) return Astro.redirect('/admin/login/');

const supabase = session.supabase;
const [gamesResult, membersResult, messagesResult] = await Promise.all([
  supabase.from('games').select('*, game_images(id, storage_path, kind, alt_text, sort_order)').order('created_at', { ascending: false }),
  supabase.from('site_members').select('id, name, role, instagram_url, sort_order, is_visible').order('sort_order', { ascending: true }),
  supabase.from('contact_messages').select('id, name, email, category, message, is_read, created_at').order('created_at', { ascending: false }).limit(50),
]);

const games = gamesResult.data ?? [];
const savedMembers = membersResult.data ?? [];
const defaultMembers = fallbackMembers.map((member) => ({
  id: member.id,
  name: member.name,
  role: member.role,
  instagram_url: member.instagramUrl ?? null,
  sort_order: member.sortOrder,
  is_visible: member.isVisible,
}));
const defaultMemberIds = new Set(defaultMembers.map((member) => member.id));
const members = [
  ...defaultMembers.map((member) => savedMembers.find((saved) => saved.id === member.id) ?? member),
  ...savedMembers.filter((member) => !defaultMemberIds.has(member.id)),
].sort((a, b) => a.sort_order - b.sort_order);
const contactMessages = messagesResult.data ?? [];
const unreadMessages = contactMessages.filter((item) => !item.is_read).length;
const accountDateFormatter = new Intl.DateTimeFormat('es-AR', { dateStyle: 'medium', timeZone: 'America/Argentina/Buenos_Aires' });
const adminAuth = createAdminAuthClient();
let accountsError = '';
let accountUsers: Array<{
  id: string;
  username: string;
  email: string;
  confirmed: boolean;
  createdAt: string;
  lastSignIn: string | null;
  ratings: Array<{ gameId: string; score: number; updatedAt: string; game: { name: string; slug: string } | null }>;
}> = [];

if (!adminAuth) {
  accountsError = 'Falta configurar SUPABASE_SECRET_KEY para consultar los usuarios desde el servidor.';
} else {
  const [profilesResult, ratingsResult, authUsersResult] = await Promise.all([
    adminAuth.from('profiles').select('user_id, username, created_at'),
    adminAuth.from('game_ratings').select('user_id, game_id, score, updated_at, games(name, slug)').order('updated_at', { ascending: false }),
    adminAuth.auth.admin.listUsers({ page: 1, perPage: 1000 }),
  ]);
  const accountError = profilesResult.error ?? ratingsResult.error ?? authUsersResult.error;
  if (accountError) accountsError = `No se pudo cargar la sección de usuarios: ${accountError.message}`;
  else {
    const profiles = new Map((profilesResult.data ?? []).map((profile) => [profile.user_id, profile]));
    const ratings = (ratingsResult.data ?? []) as Array<{ user_id: string; game_id: string; score: number; updated_at: string; games: { name: string; slug: string } | Array<{ name: string; slug: string }> | null }>;
    accountUsers = authUsersResult.data.users.map((authUser) => {
      const profile = profiles.get(authUser.id);
      return {
        id: authUser.id,
        username: profile?.username ?? `jugador_${authUser.id.slice(0, 8)}`,
        email: authUser.email ?? 'Correo no disponible',
        confirmed: Boolean(authUser.email_confirmed_at),
        createdAt: authUser.created_at,
        lastSignIn: authUser.last_sign_in_at ?? null,
        ratings: ratings.filter((rating) => rating.user_id === authUser.id).map((rating) => ({
          gameId: rating.game_id,
          score: rating.score,
          updatedAt: rating.updated_at,
          game: Array.isArray(rating.games) ? rating.games[0] ?? null : rating.games,
        })),
      };
    }).sort((a, b) => Date.parse(b.createdAt) - Date.parse(a.createdAt));
  }
}
const publicMediaUrl = (path: string) => supabase.storage.from('game-media').getPublicUrl(path).data.publicUrl;
const serializedGames = games.map((game) => ({
  ...game,
  game_images: (game.game_images ?? []).map((image: Record<string, unknown>) => ({
    ...image,
    public_url: publicMediaUrl(String(image.storage_path)),
  })),
}));
---

<AdminLayout title="Dashboard">
  <header class="admin-topbar">
    <div class="admin-shell admin-topbar__inner">
      <a class="admin-brand" href="/admin/"><img src="/brand/logo-transparent.png" alt="B&Z Studios" width="1672" height="941" /><span>Administración</span></a>
      <nav class="admin-nav" aria-label="Secciones del panel">
        <a href="#juegos">Juegos</a><a href="#equipo">Equipo</a><a href="#usuarios">Usuarios</a><a href="#mensajes">Mensajes</a>
      </nav>
      <div class="admin-user">
        <span>{session.user.email}</span>
        <a class="button button--ghost button--small" href="/" target="_blank">Ver sitio ↗</a>
        <button class="button button--ghost button--small" type="button" data-logout-open>Salir</button>
      </div>
    </div>
  </header>

  <main class="admin-main">
    <div class="admin-shell">
      <div class="admin-heading">
        <div><p class="kicker">Control central</p><h1>Dashboard B&Z</h1><p>Gestioná el catálogo, el equipo, los usuarios y los mensajes desde un solo lugar.</p></div>
        <button class="button button--primary" type="button" data-new-game>+ Nuevo juego</button>
      </div>

      <section class="admin-stats" aria-label="Resumen">
        <article><span>Juegos</span><strong>{games.length}</strong><small>{games.filter((game) => game.is_visible).length} publicados</small></article>
        <article><span>Equipo</span><strong>{members.length}</strong><small>perfiles configurables</small></article>
        <article><span>Mensajes nuevos</span><strong data-unread-count>{unreadMessages}</strong><small data-message-total>{contactMessages.length} en la bandeja</small></article>
        <article><span>Usuarios</span><strong>{accountUsers.length}</strong><small>{accountUsers.reduce((total, account) => total + account.ratings.length, 0)} calificaciones</small></article>
      </section>

      {gamesResult.error && <p class="admin-message" data-kind="error">No se pudo cargar el catálogo: {gamesResult.error.message}</p>}
      {membersResult.error && <p class="admin-message" data-kind="error">Los perfiles se muestran con sus datos iniciales. Aplicá la migración de integrantes en Supabase para poder guardarlos.</p>}
      {messagesResult.error && <p class="admin-message" data-kind="error">No se pudo cargar la bandeja de mensajes: {messagesResult.error.message}</p>}
      {accountsError && <p class="admin-message" data-kind="error">{accountsError}</p>}
      <p class="admin-message" data-admin-message hidden aria-live="polite"></p>

      <section class="admin-workspace" id="juegos">
        <div class="admin-section-heading"><div><p class="kicker">Catálogo</p><h2>Juegos</h2></div><p>Creá fichas completas, subí portadas y decidí qué aparece en el sitio.</p></div>
        <div class="admin-grid" data-game-workspace>
          <section class="admin-panel admin-panel--list">
            <div class="admin-panel__heading"><h3>Biblioteca</h3><span>{games.length} {games.length === 1 ? 'juego' : 'juegos'}</span></div>
            <div class="admin-game-list">
              {serializedGames.length === 0 && <div class="admin-empty"><strong>Sin juegos todavía</strong><p>Usá “Nuevo juego” para crear el primero.</p></div>}
              {serializedGames.map((game) => (
                <article class="admin-game">
                  <div class="admin-game__header">
                    <div><h4>{game.name}</h4><p>/{game.slug}</p></div>
                    <span class:list={['admin-visibility', { 'is-live': game.is_visible }]}>{game.is_visible ? 'Visible' : 'Oculto'}</span>
                  </div>
                  <div class="admin-game__meta"><span>{game.status}</span><span>{game.featured ? '★ Destacado' : 'Catálogo'}</span></div>
                  <div class="admin-game__actions">
                    <button class="button button--ghost button--small" type="button" data-edit-game={JSON.stringify(game)}>Editar</button>
                    <button class="button button--ghost button--small" type="button" data-toggle-game={game.id} data-visible={String(game.is_visible)}>{game.is_visible ? 'Ocultar' : 'Publicar'}</button>
                    <button class="button button--danger button--small" type="button" data-delete-game={game.id} data-game-name={game.name}>Eliminar</button>
                  </div>
                </article>
              ))}
            </div>
          </section>

          <section class="admin-panel admin-panel--editor" id="editor" data-game-editor hidden>
            <div class="admin-panel__heading">
              <div><span class="admin-step">Editor</span><h3 data-editor-title>Nuevo juego</h3></div>
              <div class="admin-editor-meta"><span>Los campos con * son obligatorios</span><button type="button" data-close-editor aria-label="Cerrar editor">×</button></div>
            </div>
            <form class="admin-form" data-game-form>
              <input type="hidden" name="id" />
              <fieldset class="admin-form-section">
                <legend>Información principal</legend>
                <div class="admin-form-grid">
                  <div class="admin-field"><label for="name">Nombre *</label><input id="name" name="name" required /></div>
                  <div class="admin-field"><label for="slug">Dirección (slug) *</label><input id="slug" name="slug" pattern="[a-z0-9]+(?:-[a-z0-9]+)*" required /><small>Ej.: monkey-climb-remastered</small></div>
                  <div class="admin-field admin-field--full"><label for="short_description">Descripción breve *</label><textarea id="short_description" name="short_description" maxlength="240" rows="3" required></textarea><small>Máximo 240 caracteres.</small></div>
                  <div class="admin-field admin-field--full"><label for="description">Descripción completa *</label><textarea id="description" name="description" rows="5" required></textarea></div>
                </div>
              </fieldset>

              <fieldset class="admin-form-section">
                <legend>Publicación y enlaces</legend>
                <div class="admin-form-grid">
                  <div class="admin-field"><label for="status">Estado *</label><select id="status" name="status" required>{GAME_STATUSES.map((status) => <option value={status}>{status}</option>)}</select></div>
                  <div class="admin-field"><label for="published_at">Fecha de publicación</label><input id="published_at" name="published_at" type="date" /></div>
                  <div class="admin-field"><label for="play_url">URL para jugar</label><input id="play_url" name="play_url" type="url" placeholder="https://" /></div>
                  <div class="admin-field"><label for="trailer_url">URL del tráiler</label><input id="trailer_url" name="trailer_url" type="url" placeholder="https://" /></div>
                  <div class="admin-field"><label for="platforms">Plataformas</label><input id="platforms" name="platforms" placeholder="Web, Windows" /><small>Separadas por comas.</small></div>
                  <fieldset class="admin-field admin-field--full admin-genre-picker" data-genre-picker>
                    <legend>Géneros *</legend>
                    <div class="admin-genre-options">{GAME_GENRES.map((genre) => <label><input type="checkbox" name="genres" value={genre} /><span>{genre}</span></label>)}</div>
                    <small>Elegí uno o varios géneros para describir y filtrar el juego.</small>
                  </fieldset>
                </div>
              </fieldset>

              <fieldset class="admin-form-section">
                <legend>Contenido del juego</legend>
                <div class="admin-form-grid">
                  <div class="admin-field"><label for="features">Características</label><textarea id="features" name="features" rows="5" placeholder="Una característica por línea"></textarea></div>
                  <div class="admin-field"><label for="controls">Controles</label><textarea id="controls" name="controls" rows="5" placeholder="Espacio | Saltar&#10;Flechas | Moverse"></textarea></div>
                  <div class="admin-field"><label for="seo_title">Título SEO</label><input id="seo_title" name="seo_title" /></div>
                  <div class="admin-field"><label for="seo_description">Descripción SEO</label><input id="seo_description" name="seo_description" maxlength="160" /><small>Máximo 160 caracteres.</small></div>
                </div>
              </fieldset>

              <fieldset class="admin-form-section">
                <legend>Imágenes y visibilidad</legend>
                <div class="admin-form-grid">
                  <div class="admin-field admin-upload"><label for="cover">Portada</label><input id="cover" name="cover" type="file" accept="image/png,image/jpeg,image/webp,image/avif" /><small>PNG, JPG, WebP o AVIF. Máximo 8 MB.</small></div>
                  <div class="admin-field admin-upload"><label for="screenshots">Capturas</label><input id="screenshots" name="screenshots" type="file" accept="image/png,image/jpeg,image/webp,image/avif" multiple /><small>Podés seleccionar varias.</small></div>
                  <div class="admin-field admin-field--full admin-checks"><label><input name="featured" type="checkbox" /> <span><strong>Destacado</strong><small>Mostrar en la página de inicio.</small></span></label><label><input name="is_visible" type="checkbox" checked /> <span><strong>Visible</strong><small>Publicar en el catálogo.</small></span></label></div>
                </div>
              </fieldset>

              <div class="admin-actions"><button class="button button--primary" type="submit">Guardar juego</button><button class="button button--ghost" type="button" data-cancel-edit>Cancelar</button></div>
            </form>
            <div class="admin-current-media" data-current-media hidden><div class="admin-panel__heading"><h3>Imágenes actuales</h3></div><div class="admin-media" data-media-list></div></div>
          </section>
        </div>
      </section>

      <section class="admin-workspace" id="equipo">
        <div class="admin-section-heading"><div><p class="kicker">Sobre nosotros</p><h2>Equipo e Instagram</h2></div><p>Estos datos aparecen en las tarjetas públicas de cada integrante.</p></div>
        <div class="admin-team-grid">
          {members.map((member, index) => (
            <form class="admin-panel admin-member-form" data-member-form>
              <input type="hidden" name="id" value={member.id} />
              <input type="hidden" name="sort_order" value={member.sort_order} />
              <div class="admin-member-form__top"><span class="member-card__avatar" aria-hidden="true">{member.name.split(' ').map((part: string) => part[0]).join('')}</span><span class="admin-step">Perfil 0{index + 1}</span></div>
              <div class="admin-field"><label for={`member-name-${member.id}`}>Nombre</label><input id={`member-name-${member.id}`} name="name" value={member.name} required /></div>
              <div class="admin-field"><label for={`member-role-${member.id}`}>Rol o descripción</label><input id={`member-role-${member.id}`} name="role" value={member.role} required /></div>
              <div class="admin-field"><label for={`member-instagram-${member.id}`}>Instagram</label><div class="admin-input-prefix"><span>@</span><input id={`member-instagram-${member.id}`} name="instagram_url" value={member.instagram_url?.replace(/^https:\/\/(www\.)?instagram\.com\//, '').replace(/\/$/, '') ?? ''} placeholder="usuario o enlace de Instagram" autocomplete="off" inputmode="url" /></div><small>Podés pegar @usuario, el usuario solo o el enlace completo.</small></div>
              <label class="admin-inline-check"><input name="is_visible" type="checkbox" checked={member.is_visible} /> Mostrar integrante en el sitio</label>
              <button class="button button--primary" type="submit">Guardar perfil</button>
            </form>
          ))}
        </div>
      </section>

      <section class="admin-workspace" id="usuarios">
        <div class="admin-section-heading"><div><p class="kicker">Comunidad</p><h2>Usuarios y calificaciones</h2></div><p>Consultá las cuentas registradas, su estado de verificación y las puntuaciones que dejaron en cada juego.</p></div>
        {!accountsError && accountUsers.length === 0 && <div class="admin-empty admin-panel"><strong>Sin usuarios registrados</strong><p>Las nuevas cuentas aparecerán en esta sección.</p></div>}
        {!accountsError && accountUsers.length > 0 && <div class="admin-account-list">
          {accountUsers.map((account) => (
            <details class="admin-account-card">
              <summary>
                <span class="admin-account-avatar" aria-hidden="true">{account.username.slice(0, 2).toUpperCase()}</span>
                <span class="admin-account-identity"><strong>{account.username}</strong><small>{account.email}</small></span>
                <span class:list={['admin-account-state', { 'is-verified': account.confirmed }]}>{account.confirmed ? 'Verificado' : 'Pendiente'}</span>
                <span class="admin-account-count"><strong>{account.ratings.length}</strong><small>{account.ratings.length === 1 ? 'calificación' : 'calificaciones'}</small></span>
                <span class="admin-account-expand" aria-hidden="true">⌄</span>
              </summary>
              <div class="admin-account-content">
                <div class="admin-account-dates"><span>Registro: <strong>{accountDateFormatter.format(new Date(account.createdAt))}</strong></span><span>Último acceso: <strong>{account.lastSignIn ? accountDateFormatter.format(new Date(account.lastSignIn)) : 'Sin ingresos'}</strong></span></div>
                {account.ratings.length ? <div class="admin-rating-list">{account.ratings.map((rating) => <article><div>{rating.game ? <a href={`/juegos/${rating.game.slug}/`} target="_blank" rel="noreferrer"><strong>{rating.game.name}</strong></a> : <strong>Juego no disponible</strong>}<small>{accountDateFormatter.format(new Date(rating.updatedAt))}</small></div><span aria-label={`${rating.score} de 5 estrellas`}>{'★'.repeat(rating.score)}{'☆'.repeat(5 - rating.score)}</span></article>)}</div> : <p class="admin-account-empty">Este usuario todavía no calificó ningún juego.</p>}
              </div>
            </details>
          ))}
        </div>}
      </section>

      <section class="admin-workspace" id="mensajes">
        <div class="admin-section-heading"><div><p class="kicker">Contacto</p><h2>Bandeja de mensajes</h2></div><p>Últimas 50 consultas, de más reciente a más antigua. Abrí una para leerla completa y preparar una respuesta por correo.</p></div>
        <Inbox messages={contactMessages} />
      </section>
    </div>
  </main>
  <dialog class="admin-dialog" data-logout-dialog aria-labelledby="logout-title">
    <div class="admin-dialog__icon" aria-hidden="true">↪</div>
    <p class="kicker">Panel privado</p>
    <h2 id="logout-title">¿Cerrar sesión?</h2>
    <p>Vas a salir del dashboard de administración. Podrás volver a ingresar con tu cuenta autorizada.</p>
    <div class="admin-dialog__actions">
      <button class="button button--ghost" type="button" data-logout-cancel>Cancelar</button>
      <form method="post" action="/admin/logout/"><button class="button button--danger" type="submit">Sí, salir</button></form>
    </div>
  </dialog>
  <script is:inline type="application/json" id="admin-games" set:html={JSON.stringify(serializedGames).replace(/</g, '\\u003c')} />
  <script>import '../../scripts/admin';</script>
</AdminLayout>
