{
  "name": "bz-studios-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/astro/bin/astro.mjs dev",
    "build": "node ./node_modules/astro/bin/astro.mjs check && node ./node_modules/astro/bin/astro.mjs build",
    "check": "node ./node_modules/astro/bin/astro.mjs check",
    "preview": "node ./node_modules/astro/bin/astro.mjs preview",
    "test:bz-id": "node scripts/check-bz-id-contract.mjs",
    "test:media": "node scripts/check-game-media.mjs",
    "test:game-access": "node scripts/check-game-access.mjs",
    "test:description": "node --test scripts/check-game-description.mjs",
    "test:admin-games": "node --test scripts/check-admin-game-accounts.mjs",
    "test:security": "node scripts/check-security.mjs",
    "test:ufo-run": "node scripts/check-ufo-run-contract.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "latest",
    "@astrojs/vercel": "^11.0.10",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "astro": "latest"
  },
  "overrides": {
    "path-to-regexp": "^6.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "latest",
    "typescript": "latest"
  }
}
