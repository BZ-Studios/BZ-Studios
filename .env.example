# Conexión pública de Supabase.
PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
PUBLIC_SITE_URL=https://bzstudios.com.ar
# Solo servidor: necesaria para consultar usuarios/calificaciones en el dashboard y eliminar cuentas.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Integración servidor-a-servidor con UFO RUN. Nunca usar prefijo PUBLIC_ ni VITE_.
UFO_RUN_SERVER_API_KEY=reemplazar_por_un_secreto_aleatorio_largo
UFO_RUN_ALLOWED_ORIGINS=https://ufo-run-web.vercel.app,http://localhost:3000

# Notificación del formulario mediante Resend (variables privadas, solo servidor).
RESEND_API_KEY=re_xxx
CONTACT_TO_EMAIL=bzstudios.games@gmail.com
# Usá onboarding@resend.dev durante la prueba o una dirección de un dominio verificado.
CONTACT_FROM_EMAIL="B&Z Studios <onboarding@resend.dev>"
